# ============================================
# CardShop — Environment Configuration
# ============================================

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=CardShop

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/cardshop

# Auth
ADMIN_SECRET_KEY=your-super-secret-admin-key-change-this
JWT_SECRET=your-jwt-secret-change-this

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Crypto Payment (Coinbase Commerce)
COINBASE_COMMERCE_API_KEY=xxx
COINBASE_COMMERCE_WEBHOOK_SECRET=xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
NEXT_PUBLIC_SUPPORT_EMAIL=support@cardshop.com

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Turnstile (Cloudflare)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=xxx
TURNSTILE_SECRET_KEY=xxx

# Encryption (for card/key storage)
ENCRYPTION_SECRET=your-32-char-encryption-secret-key

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=en
